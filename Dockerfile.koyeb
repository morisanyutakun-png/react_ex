FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

WORKDIR /app

# Install minimal system deps only.
# texlive is omitted — set CLOUD_LATEX_ONLY=1 at runtime to use cloud LaTeX
# (latex.ytotech.com) instead of local xelatex, avoiding OOM on free tier.
# build-essential / libpq-dev は不要(依存はすべて manylinux wheel で入り、
# psycopg2-binary は libpq を同梱)。apt を最小化してビルドを高速化する。
RUN apt-get update && apt-get install -y --no-install-recommends \
    poppler-utils \
    pdf2svg \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies (lightweight: no sentence-transformers/torch/scikit-learn)
# requirements-koyeb.txt は scikit-learn(+scipy)も外してビルドを高速化・確実化する。
COPY backend/requirements-koyeb.txt /app/backend/requirements-koyeb.txt
RUN pip install --no-cache-dir -r /app/backend/requirements-koyeb.txt

# Copy backend + workers (both needed at runtime)
COPY backend/ /app/backend/
COPY workers/ /app/workers/

EXPOSE 8000

WORKDIR /app/backend

# マイグレーションは「バックグラウンド」で流し、Web サーバは即起動する。
# 理由: 無料DB(Neon等)はスリープからの初回接続に数〜十数秒かかり、これを起動の
# クリティカルパスに置くとヘルスチェックが通らず provisioning が長引く。
# alembic を & で背後に回し、gunicorn を即 exec して /health を最速で 200 にする。
# (スキーマは通常すでに head なので背後実行は実質 no-op。新規DBでも数秒で追従する。)
# --workers 1: free tier のメモリ節約。--preload は UvicornWorker と相性が悪いので使わない。
# Koyeb はこのサービスをポート 8000 に転送する設定なので 8000 に固定バインドする。
CMD ["sh", "-c", "(timeout 60 alembic upgrade head || echo 'WARN: alembic skipped/timed out') & exec gunicorn main:app -k uvicorn.workers.UvicornWorker --bind 0.0.0.0:8000 --workers 1 --timeout 300"]
